APP_NAME="Jacky Chee"
APP_ENV=production
APP_KEY=
# NEVER set APP_DEBUG=true on a live server - it leaks secrets in error pages.
APP_DEBUG=false
APP_URL=https://backend.jackychee.com
APP_TIMEZONE=Asia/Hong_Kong

# Comma separated list of React front-end origins allowed to call the API (CORS)
FRONTEND_URLS=https://jackychee.com,https://www.jackychee.com,https://admin.jackychee.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jackychee_app
DB_USERNAME=jackychee_app
DB_PASSWORD=

# --- Old WordPress database (only needed while running `php artisan wp:import`) ---
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=jackychee_
WP_DB_USERNAME=
WP_DB_PASSWORD=
WP_TABLE_PREFIX=jackycheedb_
# Absolute path to the old wp-content/uploads folder
WP_UPLOADS_PATH=/home/youruser/public_html/jackychee/wp-content/uploads

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Admin API tokens expire after this many minutes (default 8 hours)
SANCTUM_TOKEN_EXPIRATION=480

# First admin account - ONLY created by `php artisan db:seed` when the users table is empty.
# Not needed if you imported jackychee_data.sql (your WordPress login keeps working).
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

MAIL_MAILER=log
